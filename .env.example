# Server-only credentials. Never commit .env.
OPENAI_API_KEY=
BROWSERBASE_API_KEY=
# Optional: the project can be inferred from the Browserbase API key.
BROWSERBASE_PROJECT_ID=
BELL_MODEL=gpt-5.6-sol
BELL_DEMO_URL=https://bell-stack-demo-site.vercel.app/protected
STAGEHAND_BROWSER=browserbase
# Disable network logging before any merchant credentials are presented.
BROWSIE_LOG_SESSION=false
# Optional shared-runtime features:
BROWSIE_PUBLIC_URL=http://127.0.0.1:4320
BROWSIE_HANDOFF_SECRET=
# Local desktop access: account name from the 1Password sidebar, not your email.
OP_ACCOUNT=
# Hosted access: a service-account token takes precedence over OP_ACCOUNT.
OP_SERVICE_ACCOUNT_TOKEN=
# Optional Linq messaging. Keep tokens and your personal number in .env.local.
LINQ_API_KEY=
LINQ_WEBHOOK_SECRET=
BELL_LINQ_PHONE_NUMBER=+16282988686
# Comma-separated E.164 numbers. Empty accepts nobody.
BELL_LINQ_ALLOWED_SENDERS=

# Baselayer sandbox. The principal must be current in the API key's organization.
BASELAYER_API_KEY=
BASELAYER_PRINCIPAL_REF=
BASELAYER_ALLOWED_ORIGINS=https://bell-stack-demo-site.vercel.app
